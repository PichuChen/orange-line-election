---
import { COMMON_STATIONS } from '../lib/stations';
import { zhTW as t } from '../i18n/zh-TW';
---
<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f07f2f" />
    <meta name="description" content="中和新蘆線蘆洲／迴龍班次的非官方迷因開票網站。" />
    <meta property="og:title" content={`${t.brand}｜${t.subtitle}`} />
    <meta property="og:description" content="本班列車究竟是蘆洲派還是迴龍派？選擇上車站，立即開票。" />
    <title>{t.brand}｜{t.subtitle}</title>
    <style>
      :root{font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI","Noto Sans TC",sans-serif;color:#1f2328;background:#f5f3ef;--orange:#f07f2f;--dark:#9e4a12;--ink:#1f2328;--muted:#6c727a;--paper:#fffefa;--line:#ded9d1;--green:#166534}*{box-sizing:border-box}body{margin:0;min-height:100vh}button{font:inherit;cursor:pointer}.shell{width:min(760px,calc(100% - 28px));margin:auto;padding:28px 0 56px}.top{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-bottom:24px}.brand{display:flex;align-items:center;gap:10px;font-weight:900}.dot,.code{display:inline-grid;place-items:center;background:var(--orange);color:#fff;font-weight:900}.dot{width:38px;height:38px;border-radius:50%;border:3px solid #fff;box-shadow:0 0 0 2px var(--orange)}.langs{font-size:12px;color:var(--muted)}.hero{padding:28px 0 24px}.kicker{display:inline-flex;border:1px solid var(--line);background:#ffffffbf;border-radius:999px;padding:7px 11px;color:var(--muted);font-weight:700;font-size:13px}h1{margin:18px 0 10px;font-size:clamp(32px,7.4vw,58px);line-height:1.04;letter-spacing:-.04em}.subtitle{margin:0;font-size:clamp(18px,3.8vw,24px);color:var(--dark);font-weight:900}.direction{display:inline-block;margin-top:14px;color:var(--muted);font-size:13px}.card{background:var(--paper);border:1px solid var(--line);border-radius:24px;box-shadow:0 18px 55px #362b2014;overflow:hidden}.panel{padding:24px}.question{margin:0 0 5px;font-size:22px}.hint{margin:0 0 18px;color:var(--muted);line-height:1.6;font-size:14px}.grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:9px}.station{appearance:none;border:1px solid var(--line);background:#fff;border-radius:14px;min-height:70px;padding:10px;text-align:left;transition:.16s}.station:hover{transform:translateY(-1px)}.station[aria-pressed="true"]{background:#fff2e7;border-color:var(--orange);box-shadow:inset 0 0 0 1px var(--orange)}.code{min-width:31px;height:23px;padding:0 6px;border-radius:8px;font-size:11px}.name{display:block;margin-top:7px;font-weight:800}.primary,.secondary{width:100%;border-radius:15px;font-weight:900}.primary{margin-top:18px;border:0;min-height:54px;background:var(--ink);color:#fff;font-size:17px}.primary:disabled{opacity:.38;cursor:not-allowed}.secondary{margin-top:16px;min-height:48px;border:1px solid var(--line);background:#fff}.hidden{display:none!important}.counting{min-height:420px;display:grid;place-items:center;text-align:center}.ballot{width:92px;height:76px;margin:0 auto 24px;border:4px solid var(--ink);border-radius:12px;position:relative;background:#f4efe7;animation:bob 1.1s ease-in-out infinite alternate}.ballot:before{content:"";position:absolute;width:54px;height:7px;border-radius:999px;background:var(--ink);top:13px;left:15px}.ballot:after{content:"O";position:absolute;width:38px;height:30px;background:var(--orange);color:#fff;font-weight:900;display:grid;place-items:center;left:23px;top:-22px;transform:rotate(-7deg);border:2px solid var(--ink)}@keyframes bob{to{transform:translateY(-8px) rotate(1deg)}}.stage{color:var(--muted);min-height:28px}.result-head{display:flex;align-items:center;justify-content:space-between;gap:12px;padding-bottom:18px;border-bottom:1px solid var(--line)}.label{color:var(--muted);font-size:13px;font-weight:800}.result-station{font-size:18px;font-weight:900}.winner{text-align:center;padding:34px 10px 26px}.winner small{display:block;color:var(--green);font-weight:900;letter-spacing:.08em;margin-bottom:8px}.winner-name{font-size:clamp(52px,15vw,92px);font-weight:1000;letter-spacing:-.06em;line-height:.95}.winner-en{margin-top:7px;color:var(--muted);font-weight:800}.candidates{display:grid;gap:10px}.candidate{display:grid;grid-template-columns:1fr auto;gap:12px;align-items:center;padding:16px;border:1px solid var(--line);border-radius:15px;background:#fff}.candidate.won{border-color:var(--orange);background:#fff4ea}.candidate strong{font-size:18px}.count{font-size:25px;font-weight:1000}.estimate-note{margin:12px 2px 0;color:var(--muted);font-size:11px;line-height:1.65}.meta{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px;margin-top:16px}.meta>div{background:#f5f3ef;border-radius:12px;padding:12px}.meta span{display:block;color:var(--muted);font-size:11px;margin-bottom:3px}.meta strong{font-size:13px;overflow-wrap:anywhere}.source-link{color:inherit;font-weight:800;text-decoration:underline;text-decoration-style:dashed;text-underline-offset:3px}.source-link:hover{color:var(--dark)}.source-link:not([href]){text-decoration:none;cursor:default}.error{margin-top:12px;color:#b42318;font-size:13px;font-weight:700}.footer{padding:20px 4px 0;color:var(--muted);font-size:11px;line-height:1.7}@media(max-width:620px){.shell{width:min(100% - 20px,760px);padding-top:18px}.grid{grid-template-columns:repeat(2,minmax(0,1fr))}.panel{padding:18px}.top{align-items:flex-start}.langs{text-align:right;max-width:150px}.meta{grid-template-columns:repeat(2,minmax(0,1fr))}}
    </style>
  </head>
  <body>
    <main class="shell">
      <div class="top"><div class="brand"><span class="dot">O</span><span>{t.brand}</span></div><div class="langs">繁中・EN / 日本語 / 한국어 soon™</div></div>
      <section class="hero"><span class="kicker">{t.kicker}</span><h1>{t.title}</h1><p class="subtitle">{t.subtitle}</p><span class="direction">{t.direction}</span></section>
      <section class="card">
        <div class="panel" id="formPanel">
          <h2 class="question">{t.stationQuestion}</h2><p class="hint">{t.stationHint}</p>
          <div class="grid">
            {COMMON_STATIONS.map((station)=><button class="station" type="button" data-station={station.id} aria-pressed="false"><span class="code">{station.id}</span><span class="name">{station.zh}</span></button>)}
          </div>
          <button class="primary" id="submitVote" type="button" disabled>{t.submit}</button>
          <p class="error hidden" id="errorMessage">開票系統暫時塞車，請再投一次。</p>
        </div>
        <div class="panel counting hidden" id="countingPanel"><div><div class="ballot" aria-hidden="true"></div><h2>{t.loadingTitle}</h2><p class="stage" id="loadingStage">{t.loadingStages[0]}</p></div></div>
        <div class="panel hidden" id="resultPanel">
          <div class="result-head"><div><div class="label">{t.resultTitle}</div><div class="result-station" id="resultStation">—</div></div><span class="code">O</span></div>
          <div class="winner"><small>{t.elected}</small><div class="winner-name" id="winnerName">—</div><div class="winner-en" id="winnerEn">—</div></div>
          <div class="candidates"><div class="candidate" data-candidate="luzhou"><strong>蘆洲派</strong><span class="count" data-count="luzhou">0 票</span></div><div class="candidate" data-candidate="huilong"><strong>迴龍派</strong><span class="count" data-count="huilong">0 票</span></div></div>
          <p class="estimate-note">{t.estimateNote}</p>
          <div class="meta"><div><span>{t.confidence}</span><strong id="confidence">—</strong></div><div><span>資料來源</span><a id="source" class="source-link" target="_blank" rel="noopener noreferrer">—</a></div><div><span>{t.voterEstimate}</span><strong id="voterEstimate">—</strong></div><div><span>{t.ridershipMonth}</span><strong id="ridershipMonth">—</strong></div></div>
          <button class="secondary" id="again" type="button">{t.again}</button>
        </div>
      </section>
      <footer class="footer"><div>{t.disclaimer}</div><div>{t.dataNote}</div><div><a href="https://github.com/PichuChen/orange-line-election" target="_blank" rel="noopener noreferrer" style="color:inherit;font-weight:800;text-decoration-style:dashed;text-underline-offset:3px">{t.contribute}</a></div></footer>
    </main>
    <script define:vars={{ loadingStages:t.loadingStages, sourceLive:t.sourceLive, sourceTimetable:t.sourceTimetable, sourceDemo:t.sourceDemo }}>
      const stationButtons=[...document.querySelectorAll('[data-station]')];
      const submit=document.getElementById('submitVote');const form=document.getElementById('formPanel');const counting=document.getElementById('countingPanel');const resultPanel=document.getElementById('resultPanel');const stage=document.getElementById('loadingStage');const error=document.getElementById('errorMessage');let selected=null;
      const sleep=(ms)=>new Promise((resolve)=>setTimeout(resolve,ms));
      const TIMETABLE_SOURCE_URL='https://data.taipei/dataset/detail?id=91cc11bb-40d6-4837-9303-84e6a666c568';
      stationButtons.forEach((button)=>button.addEventListener('click',()=>{selected=button.dataset.station;stationButtons.forEach((item)=>item.setAttribute('aria-pressed',String(item===button)));submit.disabled=false;error.classList.add('hidden')}));
      const sourceLabel=(source)=>source==='liveboard'?sourceLive:source==='timetable'?sourceTimetable:sourceDemo;
      const sourceHref=(source)=>source==='timetable'?TIMETABLE_SOURCE_URL:null;
      async function fakeCount(winner,target){const loser=winner==='luzhou'?'huilong':'luzhou';const w=document.querySelector(`[data-count="${winner}"]`);const l=document.querySelector(`[data-count="${loser}"]`);const total=Number.isFinite(target)&&target>0?Math.round(target):1;for(let i=0;i<12;i++){const progress=(i+1)/12;w.textContent=`${Math.max(0,Math.round(total*progress*(.78+Math.random()*.35)))} 票`;l.textContent=`${Math.max(0,Math.round(total*(1-progress)*Math.random()*.28))} 票`;await sleep(75)}w.textContent=`${total} 票`;l.textContent='0 票'}
      submit.addEventListener('click',async()=>{if(!selected)return;submit.disabled=true;form.classList.add('hidden');counting.classList.remove('hidden');const request=fetch('/api/draw',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({stationID:selected})}).then(async(r)=>{if(!r.ok)throw new Error('draw failed');return r.json()});try{for(const text of loadingStages){stage.textContent=text;await sleep(650)}const data=await request;counting.classList.add('hidden');resultPanel.classList.remove('hidden');const selectedButton=document.querySelector(`[data-station="${selected}"]`);document.getElementById('resultStation').textContent=`${selected} ${selectedButton.querySelector('.name').textContent}`;document.getElementById('winnerName').textContent=data.destinationZh;document.getElementById('winnerEn').textContent=data.destinationEn;document.getElementById('confidence').textContent=`${Math.round(data.confidence*100)}%`;const sourceElement=document.getElementById('source');sourceElement.textContent=sourceLabel(data.source);const sourceUrl=sourceHref(data.source);if(sourceUrl){sourceElement.setAttribute('href',sourceUrl)}else{sourceElement.removeAttribute('href')}document.getElementById('voterEstimate').textContent=data.estimatedVoters?`${data.estimatedVoters.toLocaleString()} 人`:'資料建立中';document.getElementById('ridershipMonth').textContent=data.ridershipSourceMonth??'—';document.querySelectorAll('.candidate').forEach((candidate)=>candidate.classList.remove('won'));document.querySelector(`[data-candidate="${data.camp}"]`).classList.add('won');await fakeCount(data.camp,data.estimatedVoters)}catch(e){console.error(e);counting.classList.add('hidden');form.classList.remove('hidden');submit.disabled=false;error.classList.remove('hidden')}});
      document.getElementById('again').addEventListener('click',()=>{resultPanel.classList.add('hidden');form.classList.remove('hidden');submit.disabled=!selected;document.querySelector('[data-count="luzhou"]').textContent='0 票';document.querySelector('[data-count="huilong"]').textContent='0 票'});
    </script>
  </body>
</html>
